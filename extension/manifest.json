{
  "manifest_version": 3,
  "name": "YouTube → домашний телевизор",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Продолжить текущий ролик YouTube на Samsung через скрипт Home Assistant.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "YouTube → телевизор · пульт",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icon.png"
  }
}
